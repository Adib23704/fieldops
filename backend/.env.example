# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# For local dev or VPS: postgresql://username:password@localhost:5432/fieldops_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldops_db

# Security & Auth
JWT_SECRET=super-secure-fieldops-jwt-secret-key-32chars-minimum-entropy
JWT_EXPIRES_IN=24h

# Optional: AI Provider (Groq or OpenAI compatible API)
# If left empty, system automatically uses deterministic heuristic engine
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile
